# ==============================================================================
# Authelia Secrets
# File: secrets.env  →  encrypt this to secrets.enc.env using SOPS
# ==============================================================================

# --------------------------------------------------------------------------
# Session Secret
# --------------------------------------------------------------------------
# Used to encrypt the session cookie.
# Generate with:
#   openssl rand -hex 64
AUTHELIA_SESSION_SECRET=your_long_random_session_secret_here

# --------------------------------------------------------------------------
# Storage Encryption Key
# --------------------------------------------------------------------------
# Used to encrypt Authelia’s SQLite database.
# Generate with:
#   openssl rand -hex 64
AUTHELIA_STORAGE_ENCRYPTION_KEY=your_long_random_storage_key_here

# --------------------------------------------------------------------------
# JWT Secret
# --------------------------------------------------------------------------
# Used for identity validation tokens (password reset, etc.).
# Generate with:
#   openssl rand -hex 64
AUTHELIA_JWT_SECRET=your_long_random_jwt_secret_here

# --------------------------------------------------------------------------
# User Password Hash (Argon2id)
# --------------------------------------------------------------------------
# This is the hashed version of your login password.
# Generate with:
#   docker run --rm authelia/authelia:4.39 \
#     authelia crypto hash generate argon2 --password 'YourStrongPassword'
#
# Copy the entire output (starts with $argon2id$...) and paste it below.
AUTHELIA_USER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$your_real_hash_here