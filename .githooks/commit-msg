#!/usr/bin/env bash

# Retrieve the commit message from git's temporary file
commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Regular expression matching  exact release-please types
# Pattern checks for: type(optional-scope): description
conventional_commit_regex="^(feat|fix|perf|revert|docs|style|chore|refactor|test|build|ci)(\([a-zA-Z0-9_-]+\))?!?: .+"

# Skip validation for automated merge commits or release-please pull requests
if [[ "$commit_msg" =~ ^Merge.* || "$commit_msg" =~ ^chore\(release\):.* ]]; then
    exit 0
fi

# Validate your commit message format
if [[ ! "$commit_msg" =~ $conventional_commit_regex ]]; then
    echo -e "\n\033[1;31m❌ ERROR: Invalid Commit Message Format!\033[0m"
    echo -e "Your message: \"\033[1;33m$commit_msg\033[0m\""
    echo -e "\nYour commit message must follow the Conventional Commits specification."
    echo -e "Example: \033[1;32mfeat: add automated backup script\033[0m"
    echo -e "Example: \033[1;32mchore(docker): update container port bindings\033[0m"
    echo -e "\nAllowed prefixes match your release-please config:"
    echo -e "  feat, fix, perf, revert, docs, style, chore, refactor, test, build, ci\n"
    exit 1
fi
