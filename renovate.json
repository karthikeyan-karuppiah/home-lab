{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "`(?<depName>[^`\\s]+):(?<currentValue>[^`\\s]+)`\\s*<!--\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<extractedDepName>[^`\\s]+)\\s*-->"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchFileNames": [
        "README.md"
      ],
      "pinDigests": false,
      "groupName": "Documentation Image Updates",
      "commitMessageTopic": "README documentation dependencies"
    }
  ]
}
