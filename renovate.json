{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "`(?<depName>[^`\\s]+):(?<currentValue>[^`\\s]+)`\\s*<!--\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<extractedDepName>[^\\s]+)\\s*-->"
      ]
    }
  ],
  "packageRules": [
    {
      // Fixed: Changed from 'matchFiles' to the valid schema property 'matchFileNames'
      "matchFileNames": [
        "README.md"
      ],
      "groupName": "Documentation Image Updates",
      "commitMessageTopic": "README documentation dependencies"
    }
  ]
}
